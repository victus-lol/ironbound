# Copy to .env and adjust. All values are OPTIONAL — sensible defaults apply.

# Fixed secret for signing sessions (so logins survive restarts).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
IRONBOUND_SECRET_KEY=

# Path to the SQLite database file.
#IRONBOUND_DB=ironbound.db

# 0.0.0.0 to accept connections beyond this machine (your home network).
#IRONBOUND_HOST=127.0.0.1

#IRONBOUND_PORT=5000

# 1 to mark the session cookie Secure (only when serving over HTTPS).
#IRONBOUND_COOKIE_SECURE=0

# waitress for a production-grade multi-threaded server.
#IRONBOUND_SERVER=flask

# 1 turns on the debugger — local development only, never exposed online.
#IRONBOUND_DEBUG=0